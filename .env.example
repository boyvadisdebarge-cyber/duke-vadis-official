# Copy to .env for local use. Never commit real values. Keep blanks here.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=

# Cloudinary media storage (images and videos uploaded in /admin).
# Option A (recommended): one variable, from Cloudinary Console > API Keys > "API environment variable"
#   format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Option B: the three parts (used only if CLOUDINARY_URL is blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
